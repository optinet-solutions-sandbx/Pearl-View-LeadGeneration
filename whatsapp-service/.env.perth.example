# ─────────────────────────────────────────────────────────────────────────────
# PERTH BRANCH (Asaf) — Cloud Run env for the whatsapp-service.
#
# The Perth deployment runs the SAME code as NSW; only these values differ.
# Put real secrets into Cloud Run via --update-env-vars — NOT into git.
# Anything you OMIT falls back to the NSW default baked into config.js, so you
# MUST set the whole business-identity block (else Perth invoices print NSW's
# ABN + bank account).
# ─────────────────────────────────────────────────────────────────────────────

# ── Business identity — prints on every invoice PDF. MUST be Asaf's own. ──
BUSINESS_NAME=            # Legal / bank-account name, e.g. "Asaf Window Cleaning Perth"
BUSINESS_ADDRESS=        # Pipe-separated lines: "12 Example St|Perth, Western Australia"
BUSINESS_PHONE=          # e.g. "0400 000 000"
BUSINESS_EMAIL=          # Invoice sender + reply-to, e.g. service@<perth-domain>
BUSINESS_ABN=            # Asaf's ABN
BUSINESS_BSB=            # Asaf's bank BSB
BUSINESS_ACCOUNT=        # Asaf's bank account number
BUSINESS_TZ=Australia/Perth   # AWST — keeps invoice/inquiry dates on the right day
# NOTE: In Supabase mode the invoice number comes from the next_invoice_number()
# SQL function (floor 209 → first invoice 210), NOT from INVOICE_START (which is
# Airtable-mode only). To start Perth's numbering elsewhere, edit that function's
# floor in the Perth Supabase project. Perth has its own DB, so no clash with NSW.

# ── Branding (customer-facing text) ──
BRAND_NAME=              # Marketing name in emails/booking page, e.g. "Asaf Window Cleaning"
BRAND_SHORT=             # Short brand in calendar summaries, e.g. "Asaf"
DASHBOARD_URL=           # Perth dashboard (Vercel) URL — shown in lead notifications
NOTIFY_FOOTER=           # e.g. "Asaf Perth lead notification"

# ── Supabase — Perth's OWN project/database (same Supabase account/login) ──
USE_SUPABASE=true
SUPABASE_URL=            # https://<perth-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE=   # Perth project service_role key (server-only, bypasses RLS)

# ── Gmail ingestion + sending — Asaf's OWN Google accounts ──
GMAIL_OAUTH_CLIENT_ID=       # reuse NSW OAuth app OR a new GCP OAuth client
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=    # <perth-cloud-run-url>/oauth/callback  (whitelist it in GCP)
GMAIL_FORM_REFRESH_TOKEN=    # mint at <perth-cloud-run-url>/oauth/start?account=form
GMAIL_CALL_REFRESH_TOKEN=    # mint at <perth-cloud-run-url>/oauth/start?account=call
GMAIL_SEND_REFRESH_TOKEN=    # optional dedicated send token (falls back to FORM)
FORM_GMAIL_MATCH=            # Gmail query matching PERTH's form senders, e.g.
                             #   (from:form-submission@squarespace.info) OR (from:<perth-domain>)
FORM_LABEL=Form Leads
CALL_LABEL=Call Recordings
EMAIL_LOOKBACK=newer_than:6m

# ── WhatsApp lead notifications — Asaf's number + Perth's Green-API instance ──
OWNER_PHONE=             # Asaf's WhatsApp number(s), E.164 no +, comma-separated
GREENAPI_INSTANCE_ID=    # Perth's OWN Green-API instance (its own WhatsApp sender)
GREENAPI_TOKEN=

# ── Facebook / Instagram lead ads — Asaf's own Meta Lead-Ads sheet ──
FB_LEADS_SHEET_CSV_URL=  # Google Sheet CSV export of Perth's Meta lead ads
FB_LEADS_NOTIFY_EMAIL=   # defaults to BUSINESS_EMAIL

# ── Mobile Message SMS broadcast — Perth's OWN list (or own MM account) ──
MM_USERNAME=             # Mobile Message API username
MM_API_PASSWORD=         # Mobile Message API password
MM_LIST_ID=              # Perth's broadcast list id (separate from NSW's)

# ── Booking / rebooking ──
BOOK_TOKEN_SECRET=       # UNIQUE random secret for Perth (do not reuse NSW's)
SELF_BASE_URL=           # Perth Cloud Run base URL (used for /notify-lead + /book)
REBOOK_TZ=Australia/Perth
REBOOK_INTERVAL_MONTHS=3

# ── Airtable — only if Perth ever uses the Airtable fallback (USE_SUPABASE=false) ──
# AIRTABLE_TOKEN=
# AIRTABLE_BASE_ID=
# AIRTABLE_TABLE_ID=

# ── Misc ──
ANTHROPIC_API_KEY=       # optional — incoming-WhatsApp AI auto-reply
PORT=8080
