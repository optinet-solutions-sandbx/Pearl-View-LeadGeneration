# WhatsApp Business API (Meta)
WHATSAPP_TOKEN=           # Your permanent system user access token from Meta Business Settings
WHATSAPP_PHONE_NUMBER_ID= # e.g. 10844922241403912 (from WhatsApp Manager > phone number settings)
WHATSAPP_VERIFY_TOKEN=    # Any random string you choose e.g. "pearlview-webhook-2024"
OWNER_PHONE=              # Owner's WhatsApp number in E.164 format e.g. 639241203193 (no + sign)

# Airtable
AIRTABLE_TOKEN=           # Your Airtable Personal Access Token
AIRTABLE_BASE_ID=appNc7dQkFIq0dFFM
AIRTABLE_TABLE_ID=tblS1keAU26CH08KJ

# AI
ANTHROPIC_API_KEY=        # Your Anthropic API key (claude.ai/settings -> API keys)

# Server
PORT=8080

# Facebook/Instagram Lead-Ads ingestion
FB_LEADS_SHEET_CSV_URL=   # Google Sheet CSV export URL (…/export?format=csv&gid=0)
FB_LEADS_NOTIFY_EMAIL=    # Alert recipient (default service@pearlview.com.au)
