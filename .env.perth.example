# ─────────────────────────────────────────────────────────────────────────────
# PERTH BRANCH (Asaf) — frontend build env (set these in the Perth Vercel project).
#
# The Perth dashboard is a SEPARATE Vercel project built from this SAME repo;
# only these VITE_* build vars differ from NSW. VITE_* values are baked into the
# client bundle at build time — never put a service_role key or any server secret
# here (only the anon key + public config).
# ─────────────────────────────────────────────────────────────────────────────

# ── Branding ──
VITE_BUSINESS_NAME=          # e.g. "Asaf Window Cleaning"  (sidebar + login logo + tour)
VITE_BUSINESS_INITIALS=      # optional 2-letter badge; auto-derived from the name if unset
VITE_AUTH_DOMAIN=            # hidden login email domain, e.g. "asafperth.app"

# ── Supabase — Perth's OWN project (same Supabase account) ──
VITE_USE_SUPABASE=true
VITE_SUPABASE_URL=           # https://<perth-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=      # Perth project anon key (public — RLS enforces access)

# ── Backend service (Perth Cloud Run) ──
VITE_WEBHOOK_URL=            # <perth-cloud-run-url>/notify-lead

# ── Login allow-list (Phase-7 gate) ──
VITE_ALLOWED_EMAILS=         # Asaf's login email(s), comma-separated

# ── Mobile Message SMS broadcast (optional — only if Perth uses it) ──
# VITE_MM_LIST_ID=

# ── Airtable fallback (only if VITE_USE_SUPABASE=false) ──
# VITE_AIRTABLE_TOKEN=
# VITE_AIRTABLE_BASE_ID=
# VITE_AIRTABLE_TABLE_ID=
# VITE_AIRTABLE_REVENUE_TABLE_ID=
# VITE_AIRTABLE_CALENDAR_TABLE_ID=
# VITE_AIRTABLE_CLIENTS_TABLE_ID=
# VITE_AIRTABLE_EXPENSES_TABLE_ID=
